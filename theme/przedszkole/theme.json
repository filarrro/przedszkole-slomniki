{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1140px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "30", "size": "0.75rem", "name": "Bardzo mały" },
				{ "slug": "40", "size": "1.25rem", "name": "Mały" },
				{ "slug": "50", "size": "2rem",    "name": "Średni" },
				{ "slug": "60", "size": "3.5rem",  "name": "Duży" },
				{ "slug": "70", "size": "5.5rem",  "name": "Bardzo duży" }
			]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "base",       "color": "#FDFAF5", "name": "Tło (ciepła biel)" },
				{ "slug": "surface",    "color": "#FFFFFF", "name": "Karta (biel)" },
				{ "slug": "ink",        "color": "#2B2733", "name": "Tekst" },
				{ "slug": "ink-soft",   "color": "#5F5869", "name": "Tekst pomocniczy" },
				{ "slug": "primary",    "color": "#3D2FB5", "name": "Granat" },
				{ "slug": "primary-soft","color":"#ECEAFB", "name": "Granat jasny" },
				{ "slug": "accent",     "color": "#E8961C", "name": "Akcent (miód)" },
				{ "slug": "accent-soft","color": "#FDF1DA", "name": "Akcent jasny" },
				{ "slug": "border",     "color": "#EAE3D9", "name": "Obramowanie" },
				{ "slug": "wiewiorki",  "color": "#EFA45C", "name": "Wiewiórki (pomarańcz)" },
				{ "slug": "zabki",      "color": "#7BC45F", "name": "Żabki (zielony)" },
				{ "slug": "zajaczki",   "color": "#6FBFE4", "name": "Zajączki (błękit)" },
				{ "slug": "misie",      "color": "#E88BAE", "name": "Misie (różowy)" },
				{ "slug": "kotki",      "color": "#EFC63F", "name": "Kotki (żółty)" },
				{ "slug": "jezyki",     "color": "#E4705C", "name": "Jeżyki (czerwony)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Tekst",
					"fontFamily": "Nunito, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small",   "name": "Mały",         "size": "0.9375rem",
				  "fluid": false },
				{ "slug": "medium",  "name": "Podstawowy",   "size": "1.0625rem",
				  "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large",   "name": "Duży",         "size": "1.375rem",
				  "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Nagłówek",     "size": "2rem",
				  "fluid": { "min": "1.625rem", "max": "2rem" } },
				{ "slug": "xx-large","name": "Duży nagłówek","size": "2.75rem",
				  "fluid": { "min": "2rem", "max": "2.75rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": { "left": "1.25rem", "right": "1.25rem" },
			"blockGap": "1.5rem"
		},
		"elements": {
			"link":    { "color": { "text": "var(--wp--preset--color--primary)" } },
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" },
				":hover": { "color": { "background": "#2E2390", "text": "#FFFFFF" } },
				":focus": { "color": { "background": "#2E2390", "text": "#FFFFFF" } },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": { "fontWeight": "700" }
			}
		},
		"blocks": {
			"core/image": { "border": { "radius": "14px" } },
			"core/quote": {
				"color": { "background": "var(--wp--preset--color--accent-soft)" },
				"spacing": { "padding": { "top": "1.25rem", "bottom": "1.25rem", "left": "1.5rem", "right": "1.5rem" } },
				"border": { "radius": "14px" }
			}
		}
	}
}
